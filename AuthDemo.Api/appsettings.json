{
  "ConnectionStrings": {
    "DefaultConnection": "Server=192.168.1.35,1433;Database=AuthDemoDB;User Id=sa;Password=YourStrong@Passw0rd2026;TrustServerCertificate=True;",
    "//DefaultConnection": "Host=192.168.1.35;Port=5432;Database=AuthDemoDB;Username=admin;Password=admin123"
  },
  "//Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "OpenIddict": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ], // Các gói Sink được sử dụng
    "MinimumLevel": {
      "Default": "Information", // Mức log mặc định
      "Override": { // Ghi đè mức log cho các namespace cụ thể
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [ // Các Sink và cấu hình của chúng
      { "Name": "Console" }, // Sử dụng Console Sink
      {
        "Name": "File", // Sử dụng File Sink
        "Args": {
          "path": "logs/log-.txt", // Path file, {Date} tạo file theo ngày
          "rollingInterval": "Day", // Tạo file mới mỗi ngày
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" // Định dạng output
        }
      }
      // Thêm các Sink khác tại đây, ví dụ: Seq, Elasticsearch...
    ],
    "Enrich": [ // Thêm các Enricher để làm giàu log
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": { // Các thuộc tính cố định cho tất cả log
      "Application": "MyWebApp"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "Accept", "X-Requested-With" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ]
  },
  "//AllowedHosts": "Whitelist Host header — chặn Host Header Injection attack. Tự động đọc bởi HostFilteringMiddleware (đăng ký sẵn trong WebApplication.CreateBuilder). Production phải set đúng domain, ví dụ: 'api.myapp.com;www.myapp.com'",
  "AllowedHosts": "*"
}
